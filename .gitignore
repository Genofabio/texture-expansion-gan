# ==========================================
# CUSTOM GAN PROJECT FILES
# ==========================================

# 1. Ignore all automatically generated outputs (Checkpoints, Logs, Samples)
outputs/

# 2. Ignore cropped datasets generated by the script
data/training/crops/
data/evaluation/crops/

# 3. Preserve input folder structures but ignore heavy source images
data/training/originals/*
!data/training/originals/.gitkeep

data/evaluation/originals/*
!data/evaluation/originals/.gitkeep

data/generation/*
!data/generation/.gitkeep

# 4. Preserve official weights folder but ignore local model checkpoints
weights/*
!weights/.gitkeep